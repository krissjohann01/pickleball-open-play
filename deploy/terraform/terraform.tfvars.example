# Copy this file to terraform.tfvars and fill in the DuckDNS values (get
# them from https://www.duckdns.org, see deploy/README.md). Everything else
# has a sensible default (see variables.tf).

duckdns_subdomain = "yourclubname"     # the part before .duckdns.org
duckdns_token     = "paste-your-duckdns-token-here"

# aws_region     = "us-east-1"
# instance_type  = "t3.micro"      # free-tier eligible for an account's first 12 months
# app_port       = 4321
# root_volume_gb = 8

# Only needed if the IP Terraform auto-detects is wrong (e.g. deploying
# through a VPN) or you want to allow SSH from somewhere else:
# allowed_ssh_cidr = "203.0.113.4/32"

# Debug only — temporarily exposes app_port directly, bypassing Caddy/HTTPS:
# expose_app_port_directly = true
